PORT=4000
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://zylo:zylo@localhost:5432/zylo
TEST_DATABASE_URL=postgres://zylo:zylo@localhost:5432/zylo_test
# From the Clerk dashboard → API keys (app named "Zylo")
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Local dev: `npm run livekit` (brew install livekit) prints these on startup.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Redis: live meeting state (seats, lobby, screen share), shared rate limits and the
# translation cache. Unset: rate limits and the cache fall back to per-server memory,
# but meetings need Redis, so every join is refused.
REDIS_URL=redis://localhost:6379
# Proxy hops in front of this server: 0 locally, 1 behind Railway or Fly.
TRUST_PROXY=0
# Logs: production prints one JSON line per entry ({"time","level","msg",…}) for the
# host's log search; anything else prints readable text. On Railway: NODE_ENV=production.
NODE_ENV=development

# Zylo AI (Ask AI in ZyloChat): any OpenAI-compatible chat API. Ask AI is on only when
# both AI_API_KEY and AI_MODEL are set. There is no default model on purpose: older Grok
# names silently bill at flagship rates. Models checked on docs.x.ai on 2026-10-02:
#   xAI:    AI_BASE_URL=https://api.x.ai/v1  AI_MODEL=grok-4.3 (cheaper, $1.25 / $2.50 per million tokens in / out)
#                                            AI_MODEL=grok-4.7 (best, $2 / $6)
#   NVIDIA: AI_BASE_URL=https://integrate.api.nvidia.com/v1  AI_MODEL=meta/llama-3.1-70b-instruct
# AI_BASE_URL defaults to https://api.x.ai/v1 when unset.
AI_BASE_URL=https://api.x.ai/v1
AI_API_KEY=
AI_MODEL=
